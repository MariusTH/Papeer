{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tablet PDF Writer",
  "version": "0.1.0",
  "identifier": "com.mariushorne.tabletpdfwriter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tablet PDF Writer",
        "width": 1200,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#d9d1c3"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Handwrite on PDFs with a pen tablet",
    "longDescription": "Write on PDFs or blank notebooks with a pen tablet, reMarkable-style. Pages grow as you write, notes live in the margin, and you export a clean PDF.",
    "copyright": "\u00a9 2026 Marius Horne",
    "publisher": "Marius Horne",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        },
        "appPosition": {
          "x": 160,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 440,
          "y": 180
        }
      },
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
